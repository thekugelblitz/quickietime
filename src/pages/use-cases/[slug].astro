---
import PublicPage from '@/src/components/PublicPage.astro';
import StudioCTA from '@/src/components/StudioCTA.astro';
import { useCases } from '@/lib/content';
import { toolCatalog } from '@/lib/config';

export function getStaticPaths() {
  return useCases.map((u) => ({
    params: { slug: u.slug },
    props: { useCase: u },
  }));
}

const { useCase: u } = Astro.props;
const { slug } = Astro.params;
---

<PublicPage
  title={u.title}
  intro={u.intro}
  path={`/use-cases/${slug}`}
  eyebrow="A WORKFLOW THAT FITS"
  metaTitle={u.title}
  metaDescription={u.description}
>
  <div class="workflow-steps">
    {u.steps.map(([heading, body], i) => (
      <section>
        <span>0{i + 1}</span>
        <div>
          <h2>{heading}</h2>
          <p>{body}</p>
        </div>
      </section>
    ))}
  </div>
  <section class="editorial-example">
    <span>AN EXAMPLE BRIEF</span>
    <p>{u.example}</p>
  </section>
  <section class="prose-section">
    <h2>Tools for this workflow</h2>
    <div class="related-tools">
      {u.tools.map((t) => (
        <a class="tool-use" href={`/tools/${t}`}>
          {toolCatalog.find((x) => x.id === t)?.name} →
        </a>
      ))}
    </div>
    <p>Review every draft before using it. AI can make errors, and public examples do not guarantee identical results.</p>
  </section>
  <StudioCTA tool={u.tools[0]} />
  <a class="text-link" href="/use-cases">Explore other workflows →</a>
</PublicPage>
