---
import PublicPage from '@/src/components/PublicPage.astro';
---

<PublicPage
  title="Start free. Make room for more."
  intro="A daily helping of ideas, with extra credits when you need them."
  path="/pricing"
  metaTitle="AI writing plans & credit packs"
  metaDescription="Start with 5 guest or 20 account credits per day. Buy optional one-time credit packs with no expiry and no recurring subscription."
>
  <div class="public-prose wide-prose">
    <div class="plan-cards">
      <section>
        <span>JUST EXPLORING</span>
        <h2>Guest</h2>
        <strong>5 <small>credits / day</small></strong>
        <p>No account needed. History and favorites stay in your current browser.</p>
        <a class="primary-button" href="/">Start writing</a>
      </section>
      <section>
        <span>YOUR OWN CREATIVE CORNER</span>
        <h2>Free account</h2>
        <strong>20 <small>credits / day</small></strong>
        <p>Verify your email. Save work, create projects, search history and keep versions.</p>
        <a class="primary-button" href="/auth">Create a free account</a>
      </section>
    </div>

    <h2>Compare the allowances</h2>
    <div class="comparison-wrap">
      <table class="comparison-table">
        <thead>
          <tr>
            <th scope="col">Feature</th>
            <th scope="col">Guest</th>
            <th scope="col">Free account</th>
          </tr>
        </thead>
        <tbody>
          {[
            ['Daily AI requests', '5', '20'],
            ['Tagline ideas per generation', '3 or 5', '3, 5, 10 or 15'],
            ['Headline ideas per generation', '3 or 5', '3, 5 or 10'],
            ['Caption alternatives', '1 or 3', '1, 3 or 5'],
            ['Long-draft output ceiling', '300 words', '700 words'],
            ['Summary input ceiling', '12,000 characters', '24,000 characters'],
            ['Rewrite/reply input ceiling', '8,000 characters', '16,000 characters'],
            ['Other tool input ceiling', '4,000 characters', '4,000 characters'],
            ['Projects & full account history', 'Browser history only', 'Included'],
            ['Manual editing, format conversion & copying', 'Free', 'Free']
          ].map((row) => (
            <tr>
              <th scope="row">{row[0]}</th>
              <td>{row[1]}</td>
              <td>{row[2]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>Small print, in normal-sized words</h2>
    <p>
      Credits reset at midnight UTC. Optional credit packs are one-time purchases with no automatic renewal. Purchased
      credits do not expire and are used after your daily allowance. Failed requests are refunded. Taglines have a
      per-idea limit of 5, 10 or 16 words; headlines and subject lines have character limits. A summary stays shorter
      than its source. Caption word ceilings apply across the batch. Output may be shorter than its maximum.
    </p>
    <p>
      Guest credits are shared by visitors using the same public network address. Account credits belong to the
      verified account. Do not create multiple accounts to evade limits.
    </p>

    <!-- Container for dynamic published plans -->
    <div id="live-credit-packs"></div>
  </div>
</PublicPage>
