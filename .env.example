# Set these once in Dokploy's Environment panel, not in source files.
SITE_URL=https://qtai.click
SITE_OPERATOR=HostingSpell LLP
CONTACT_EMAIL=support@qtai.click
SITE_INDEXABLE=true
# Generate three independent values using: openssl rand -hex 32
AUTH_SECRET=
SETTINGS_ENCRYPTION_KEY=
ADMIN_SETUP_TOKEN=
# Complete /bhai setup, then remove ADMIN_SETUP_TOKEN from Dokploy.
TRUST_PROXY=true
DATABASE_PATH=./data/quickietime.sqlite
# AI, SMTP, payments and costs are managed through /bhai.
# Optional environment fallback for an existing installation:
AI_PROVIDER=cheaperinference
AI_MODEL=gpt-5.6-luna
# SMTP email delivery (configured for ncr1.int3rnet.net:465)
SMTP_HOST=ncr1.int3rnet.net
SMTP_PORT=465
SMTP_USER=support@qtai.click
SMTP_PASSWORD=$~=YL1mwK%VFHqNk
SMTP_FROM=QuickieTime <support@qtai.click>
# Google Sign-In (Redirect URI: https://qtai.click/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
