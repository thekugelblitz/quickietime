    "@shadcn/react": "^0.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.13.8",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "lucide-svelte": "^1.0.1",
